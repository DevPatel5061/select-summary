{
  "name": "Select Summary",
  "description": "Turn highlighted text into a concise Gemini summary. Local history and activity, with no extension tracking.",
  "version": "3.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Select Summary",
    "default_icon": {
      "128": "icon/icon.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Alt+G"
      },
      "description": "Open Select Summary"
    },
    "summarize-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Summarize selected text"
    }
  },
  "icons": {
    "128": "icon/icon.png"
  },
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["summary.css", "icon/onboarding.svg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://generativelanguage.googleapis.com; base-uri 'none'; frame-ancestors 'none'"
  }
}
